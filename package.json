{
  "name": "acadex",
  "private": true,
  "license": "UNLICENSED",
  "description": "Acadex — the AI-native platform for running schools, colleges and universities",
  "author": "Syed Ibrahim Ali",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibrahim123-sia/Acadex.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @acadex/api\" \"npm run dev -w @acadex/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @acadex/api",
    "db:seed": "npm run db:seed -w @acadex/api",
    "db:reset": "npm run db:reset -w @acadex/api",
    "db:empty": "npm run db:empty -w @acadex/api --",
    "admin:create": "npm run admin:create -w @acadex/api --",
    "e2e": "playwright test",
    "secrets:check": "node scripts/leak-scan.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
