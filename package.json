{
  "name": "acadex",
  "private": true,
  "description": "Acadex — AI-native learning platform and institute management for every kind of institution",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @acadex/api\" \"npm run dev -w @acadex/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @acadex/api",
    "db:seed": "npm run db:seed -w @acadex/api",
    "db:reset": "npm run db:reset -w @acadex/api",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
