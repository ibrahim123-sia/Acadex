# Copy to apps/web/.env.local to override.
# Where the API lives. Default '/api' (same origin; the dev server proxies it to localhost:5000).
# For an API on another domain, e.g. https://api.acadex.app/api (then set CORS_ORIGINS and
# COOKIE_SAMESITE on the API accordingly).
VITE_API_URL=/api
# Where the dev server proxies /api (development only)
API_PROXY_TARGET=http://localhost:5000
# Optional error reporting
VITE_SENTRY_DSN=

# Google Drive / OneDrive file pickers in course link items (optional; public client ids, not secrets)
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_ONEDRIVE_CLIENT_ID=
