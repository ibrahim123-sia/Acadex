# Copy to apps/api/.env and fill in. Never commit the real .env.

# PostgreSQL connection string (Neon: copy from the dashboard; use sslmode=verify-full)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
# true (verified TLS, default) | no-verify | false (local Postgres without TLS)
DATABASE_SSL=true
# optional: a direct (not pooled) connection for live events and background jobs
# (defaults to DATABASE_URL; Neon pooled hosts "-pooler" are switched to the direct host)
DATABASE_DIRECT_URL=
# connections per API process (each in-flight request holds one for its transaction)
DATABASE_POOL_MAX=20

PORT=5000
NODE_ENV=development

# --- Authentication ---
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
# access tokens are short-lived and renewed with the refresh cookie
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90
# required | optional — administrators must use 2FA; defaults to required when NODE_ENV=production
ADMIN_MFA=optional
# 32-byte key encrypting 2FA secrets (required in production): openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# refresh cookie: Secure defaults to true in production; SameSite strict|lax|none
# (none is only needed when the web app runs on another site than the API, e.g. custom domains)
COOKIE_SECURE=
COOKIE_SAMESITE=strict

# --- Email ---
# Base URL of the web app (used in invitation / reset links)
APP_URL=http://localhost:3000
# log: emails are only recorded in the email_outbox table + log (development)
# smtp: delivered via SMTP_URL, e.g. smtp://user:pass@smtp.example.com:587
MAIL_DRIVER=log
SMTP_URL=
MAIL_FROM=Acadex <no-reply@acadex.app>

# --- HTTP ---
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to true (or a hop count / subnet) when running behind a proxy or load balancer
TRUST_PROXY=false
# Failed logins allowed per IP+email per 15 minutes; requests per IP per minute
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600

# --- Observability ---
# fatal | error | warn | info | debug | trace | silent; LOG_PRETTY=true for readable local logs
LOG_LEVEL=info
LOG_PRETTY=false
# Error reporting (optional)
SENTRY_DSN=

# Tests start their own embedded Postgres; set this to use an existing (separate!) database
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/acadex_test

# --- Files (photos, documents, imports) ---
# local: files under STORAGE_LOCAL_DIR (development); s3: any S3-compatible store
# (AWS S3, Cloudflare R2, MinIO — for docker-compose MinIO use S3_ENDPOINT=http://localhost:9000,
#  S3_BUCKET=acadex-files, S3_FORCE_PATH_STYLE=true, keys acadex / acadex-dev-secret)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# none | clamav (every upload is streamed to clamd; a scanner outage rejects uploads)
VIRUS_SCAN=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Background jobs ---
# pgboss: queues in PostgreSQL (schema pgboss); inline: in memory (tests only)
JOBS_DRIVER=pgboss
# run the workers inside the API process; set false when running `npm run worker` separately
JOBS_WORKER=true
# internal: pg-boss runs the schedules; external: an outside scheduler (Cloudflare cron trigger) calls
# POST /api/internal/cron with the header x-acadex-cron: CRON_SECRET (see docs/cloudflare.md)
JOBS_SCHEDULE=internal
# leave empty unless JOBS_SCHEDULE=external; set it as a secret, never in a file (openssl rand -hex 32)
CRON_SECRET=

# --- Push notifications (browser) ---
# none | webpush (needs VAPID keys: npx web-push generate-vapid-keys) | fake (tests)
PUSH_DRIVER=none
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@acadex.app

# --- Payments (each institution connects its own Stripe / JazzCash / Easypaisa account in
# Settings → Payments; the keys are stored encrypted). Providers call back to this address:
# API_PUBLIC_URL=https://api.example.com/api

# --- Text messages and WhatsApp (fee reminders, alerts)
# SMS: none | log | fake | twilio      WhatsApp: none | log | fake | twilio | meta
SMS_DRIVER=log
WHATSAPP_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TEMPLATE=acadex_notice

# --- Live classes: each institution connects Zoom / Teams / Meet in Settings → Integrations.
# Zoom sends recordings and joins to API_PUBLIC_URL/integrations/zoom/webhook. fake = tests only.
LIVE_DRIVER=real

# --- Platform billing (the platform's own Stripe account; institutions can also pay by bank)
# Webhook: API_PUBLIC_URL/billing/stripe/webhook (event checkout.session.completed)
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=

# --- Sign in with Google / Microsoft (only for existing accounts on plans with SSO)
# Redirect URIs: API_PUBLIC_URL/auth/sso/google/callback and …/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- AI (fake = deterministic, no network; auto = the first provider with a key below)
AI_PROVIDER=auto
AI_DISABLED=false
# AI requests per person per minute
AI_RATE_LIMIT=30
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# monthly AI spend cap per plan (USD); institutions on their own key are not capped
AI_BUDGET_FREE_USD=2
AI_BUDGET_PRO_USD=50
AI_BUDGET_ENTERPRISE_USD=500
