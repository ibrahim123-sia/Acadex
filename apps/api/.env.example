# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL connection string (Neon: copy from the dashboard; use sslmode=verify-full)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
# true (verified TLS, default) | no-verify | false (local Postgres without TLS)
DATABASE_SSL=true

# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
# Session length (zeit/ms format)
JWT_EXPIRES_IN=12h

PORT=5000
NODE_ENV=development

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to true (or a hop count / subnet) when running behind a proxy or load balancer
TRUST_PROXY=false

# Failed logins allowed per IP+email per 15 minutes; requests per IP per minute
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600

# Tests start their own embedded Postgres; set this to use an existing (separate!) database
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/acadex_test
