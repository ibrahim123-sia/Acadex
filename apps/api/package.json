{
  "name": "@acadex/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/migrate.ts && tsx src/db/seed.ts --reset",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "description": "Acadex API",
  "dependencies": {
    "@acadex/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module"
}
