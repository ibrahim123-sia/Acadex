// Acadex on Cloudflare — Worker + static assets + API container + cron trigger.
// Full walk-through: docs/cloudflare.md. Values marked REPLACE-ME are yours to fill in.
// Never put a secret in this file: secrets go in with `npx wrangler secret put NAME`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acadex",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // the web app (build it first: npm run build:web) — a single-page app, so unknown paths get
  // index.html; /api/* goes to the Worker (and from there to the API container)
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // the API: apps/api/Dockerfile, built by wrangler on deploy (Docker must be running)
  "containers": [
    {
      "class_name": "AcadexApi",
      "image": "../apps/api/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "AcadexApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AcadexApi"] }],

  // every 5 minutes: wake the API and queue the scheduled jobs that fell due (needs CRON_SECRET)
  "triggers": { "crons": ["*/5 * * * *"] },

  // your domain (after adding it to Cloudflare). Until then the app lives on *.workers.dev.
  // "routes": [{ "pattern": "REPLACE-ME.example.com", "custom_domain": true }],

  // plain configuration for the API (not secret). Everything here and every secret reaches the
  // container as an environment variable — see apps/api/.env.example for the full list.
  "vars": {
    "API_INSTANCES": "1",
    "APP_URL": "https://REPLACE-ME.example.com",
    "CORS_ORIGINS": "https://REPLACE-ME.example.com",
    "COOKIE_SECURE": "true",
    "DATABASE_SSL": "true",
    "JOBS_DRIVER": "pgboss",
    "JOBS_WORKER": "true",
    "STORAGE_DRIVER": "s3",
    "S3_BUCKET": "acadex-files",
    "S3_REGION": "auto",
    "S3_FORCE_PATH_STYLE": "true",
    "S3_ENDPOINT": "https://REPLACE-ME-ACCOUNT-ID.r2.cloudflarestorage.com",
    "MAIL_DRIVER": "smtp",
    "MAIL_FROM": "Acadex <no-reply@REPLACE-ME.example.com>",
    "LOG_LEVEL": "info"
  }
  // secrets (wrangler secret put …): DATABASE_URL, DATABASE_DIRECT_URL, JWT_SECRET,
  // MFA_ENCRYPTION_KEY, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, SMTP_URL, CRON_SECRET, and any
  // optional provider keys you use (ANTHROPIC_API_KEY, BILLING_STRIPE_SECRET_KEY, …)
}
